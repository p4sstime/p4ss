"AppBuild"
{
	"AppID" "3655900" // your AppID
	"Desc" "Playtest build" // internal description for this build
	"verbose" "1" // spew more build details in console
	"preview" "0" // make this a preview build only, nothing is uploaded

	"ContentRoot" "../../game" // root content folder, relative to location of this file
	"BuildOutput" "../output/" // build output folder for build logs and build cache files

	// "SetLive" "test" // automatically publish this build to the test branch

	"Depots"
	{
		"3655901" // content
		{
			"FileMapping"
			{
				"LocalPath" "*" // all files from contentroot folder
				"DepotPath" "." // mapped into the root of the depot
				"recursive" "1" // include all subfolders
			}
			"FileExclusion" "bin/*" // exclude linux64 binaries
			"FileExclusion" "p4ss_linux64*"
			"FileExclusion" "p4ss_win64*"
			"FileExclusion" "p4ss/bin/*"
			"FileExclusion" "p4ss/linux64/*"
		}
		"3655902"
		{
			"FileMapping"
			{
				"LocalPath" "./bin/linux64/*" // all files from contentroot folder
				"DepotPath" "./bin/linux64/" // mapped into the root of the depot
				"recursive" "1" // include all subfolders
			}
			"FileMapping"
			{
				"LocalPath" "p4ss_linux64" // all files from contentroot folder
				"DepotPath" "." // mapped into the root of the depot
			}
			"FileMapping"
			{
				"LocalPath" "./p4ss/bin/linux64/*" // all files from contentroot folder
				"DepotPath" "./p4ss/bin/linux64/" // mapped into the root of the depot
				"recursive" "1" // include all subfolders
			}
			"FileExclusion" "*.dbg"
		}
		"3655903"
		{
			"FileMapping"
			{
				"LocalPath" "./bin/x64/*" // all files from contentroot folder
				"DepotPath" "./bin/x64/" // mapped into the root of the depot
				"recursive" "1" // include all subfolders
			}
			"FileMapping"
			{
				"LocalPath" "p4ss_win64.exe" // all files from contentroot folder
				"DepotPath" "." // mapped into the root of the depot
			}
			"FileMapping"
			{
				"LocalPath" "./p4ss/bin/x64/*" // all files from contentroot folder
				"DepotPath" "./p4ss/bin/x64/" // mapped into the root of the depot
				"recursive" "1" // include all subfolders
			}
			"FileExclusion" "*.pdb"
		}
	}
}