"AppBuild"
{
	"AppID" "3717640" // your AppID
	"Desc" "Dedicated server build" // internal description for this build
	"verbose" "1" // spew more build details in console
	"preview" "0" // make this a preview build only, nothing is uploaded

	"ContentRoot" "../../game" // root content folder, relative to location of this file
	"BuildOutput" "../output/" // build output folder for build logs and build cache files

	"Depots"
	{
		"3717641" // content
		{
			"FileMapping"
			{
				"LocalPath" "*" // all files from contentroot folder
				"DepotPath" "." // mapped into the root of the depot
				"recursive" "1" // include all subfolders
			}
			"FileMapping"
			{
				"LocalPath" "./p4ss/playtest_gameinfo.txt"
				"DepotPath" "./p4ss/gameinfo.txt"
			}
			"FileMapping"
			{
				"LocalPath" "./p4ss/playtest_steam.inf"
				"DepotPath" "./p4ss/steam.inf"
			}
			"FileExclusion" "bin/*"
			"FileExclusion" "p4ss_linux64*"
			"FileExclusion" "p4ss_win64*"
			"FileExclusion" "srcds_linux64*"
			"FileExclusion" "srcds_win64*"
			"FileExclusion" "srcds.sh"
			"FileExclusion" "p4ss/bin/*"
			"FileExclusion" "p4ss/linux64/*"
			"FileExclusion" "p4ss/gameinfo.txt"
			"FileExclusion" "p4ss/steam.inf"
		}
		"3717643"
		{
			"FileMapping"
			{
				"LocalPath" "srcds_linux64"
				"DepotPath" "."
			}
			"FileMapping"
			{
				"LocalPath" "srcds.sh"
				"DepotPath" "."
			}
			"FileMapping"
			{
				"LocalPath" "./p4ss/bin/linux64/server_srv.so"
				"DepotPath" "./p4ss/bin/linux64/"
			}
		}
	}
}
