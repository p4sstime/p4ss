#!/bin/bash

set -euo pipefail

# Example: 2026-02-04 13:01:22
date=$(date +"%Y-%m-%d %H:%M:%S")
# Example: d096d265 (modified)
info=$(git describe --always --dirty=" (modified)")
# Example: Linux 6.18.7-arch1-1
os=$(uname -sr)

# output to put in the build
echo "\
// This file was generated by devtools/genbuildinfo.
// Do ***not*** edit it by hand.

const char* g_szbuildInfo = \"p4ss commit $info at $date ($os)\";
const char* g_szbuildCommit = \"$info\";
const char* g_szbuildDate = \"$date\";
const char* g_szbuildOs = \"$os\";"