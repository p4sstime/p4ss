/// buildinfo.vpc
/// Purpose: Dynamically generate a string at build time corresponding to 
/// build properties and details.

$Configuration
{
	$Compiler
	{
    $AdditionalIncludeDirectories "$BASE;$SRCDIR\game\client\generated_p4ss"
  }
}

$Project
{
  $Folder "Generated Files"
  {
    $DynamicFile "$SRCDIR\game\client\generated_p4ss\buildinfo.gen.cpp" [$LINUX64] // remove that when it is on windows too
    $File "$SRCDIR\game\client\generated_p4ss\buildinfo.h"
  }
  $Folder "Codegen details (do not open)" [$LINUX64]
  {
    // lucy: This is the most evil line in the entire
    // codebase
    $File "/proc/self/environ"
    {
      $Configuration 
      {
        $CustomBuildStep
        {
	        $CommandLine "$SRCDIR/devtools/genbuildinfo > $SRCDIR/game/client/generated_p4ss/buildinfo.gen.cpp"
          $Outputs "$SRCDIR\game\client\generated_p4ss\buildinfo.gen.cpp"
	        $Description   "Generating build info..."
        }
      }
    }
  }
}


