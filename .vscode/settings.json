{
  "clangd.arguments": [
    "--compile-commands-dir=src"
  ],
  "editor.formatOnSave": false,
  "C_Cpp.clang_format_style": "file",
  "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
  "cmake.ignoreCMakeListsMissing": true,
  "[vdf]": {
    "editor.defaultFormatter": "pfwobcke.vscode-vdf"
  },
  "[lua]": {
    "gitlens.codeLens.scopes": [
      "document"
    ],
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
  },
  "Lua.diagnostics.globals": [
    "UI"
  ],
  "Lua.workspace.library": [
    "${workspaceFolder}/game/resource/ui/schema.lua",
  ],
  "Lua.runtime.version": "LuaJIT",
  "files.associations": {
    "*.COBOL*": "cobol",
    "*.COB*": "cobol",
    "*.COBCOPY*": "cobol",
    "*.COPYBOOK*": "cobol",
    "*.COPY*": "cobol",
    "*.PL1*": "pl1",
    "*.PLI*": "pl1",
    "*.INC*": "pl1",
    "*.INCLUDE*": "pl1",
    "*.JCL*": "jcl",
    "*.ASM*": "hlasm",
    "*.ASSEMBLE*": "hlasm",
    "*.HLASM*": "hlasm",
    "*.HLA*": "hlasm",
    "*.MACLIB*": "hlasm",
    "*.EXEC*": "rexx",
    "*.REXX*": "rexx",
    "*.REXXINC*": "rexx",
    "*.copyasm": "hlasm",
    "*.macasm": "hlasm",
    "*.bms": "hlasm",
    "*.rex": "rexx",
    "*.rexx": "rexx",
    "iostream": "cpp",
    "ostream": "cpp",
    "new": "cpp",
    "memory": "cpp",
    "vector": "cpp",
    "array": "cpp",
    "atomic": "cpp",
    "*.tcc": "cpp",
    "cctype": "cpp",
    "clocale": "cpp",
    "cmath": "cpp",
    "cstdarg": "cpp",
    "cstddef": "cpp",
    "cstdint": "cpp",
    "cstdio": "cpp",
    "cstdlib": "cpp",
    "cwchar": "cpp",
    "cwctype": "cpp",
    "deque": "cpp",
    "unordered_map": "cpp",
    "exception": "cpp",
    "algorithm": "cpp",
    "functional": "cpp",
    "iterator": "cpp",
    "memory_resource": "cpp",
    "numeric": "cpp",
    "random": "cpp",
    "string": "cpp",
    "system_error": "cpp",
    "tuple": "cpp",
    "type_traits": "cpp",
    "utility": "cpp",
    "fstream": "cpp",
    "initializer_list": "cpp",
    "iosfwd": "cpp",
    "istream": "cpp",
    "limits": "cpp",
    "sstream": "cpp",
    "stdexcept": "cpp",
    "streambuf": "cpp",
    "typeinfo": "cpp",
    "optional": "cpp",
    "any": "cpp",
    "hash_map": "cpp",
    "hash_set": "cpp",
    "bit": "cpp",
    "bitset": "cpp",
    "charconv": "cpp",
    "chrono": "cpp",
    "codecvt": "cpp",
    "compare": "cpp",
    "complex": "cpp",
    "concepts": "cpp",
    "condition_variable": "cpp",
    "cstring": "cpp",
    "ctime": "cpp",
    "forward_list": "cpp",
    "list": "cpp",
    "map": "cpp",
    "set": "cpp",
    "unordered_set": "cpp",
    "ratio": "cpp",
    "source_location": "cpp",
    "string_view": "cpp",
    "format": "cpp",
    "future": "cpp",
    "iomanip": "cpp",
    "mutex": "cpp",
    "numbers": "cpp",
    "queue": "cpp",
    "ranges": "cpp",
    "semaphore": "cpp",
    "span": "cpp",
    "stack": "cpp",
    "stdfloat": "cpp",
    "stop_token": "cpp",
    "text_encoding": "cpp",
    "thread": "cpp",
    "cinttypes": "cpp",
    "valarray": "cpp",
    "variant": "cpp"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "discord.enabled": false,
  "stylua.targetReleaseVersion": "latest",
}